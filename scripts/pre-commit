#!/bin/bash
echo "[DevSecOps Pipeline] Triggering automated pre-commit SonarQube scan..."

# Ensure we are executing from the repository root directory context
cd "$(git rev-parse --show-toplevel)"

# Run the scanner using the verified internal host IP routing configuration
docker run --rm \
  -v "$(pwd):/usr/src" \
  sonarsource/sonar-scanner-cli \
  -Dsonar.projectKey=python-automation-app \
  -Dsonar.sources=. \
  -Dsonar.host.url=http://${SONAR_HOST}:8080 \
  -Dsonar.token=${sq-token} \

SCAN_EXIT_CODE=$?

if [ $SCAN_EXIT_CODE -ne 0 ]; then
  echo "[DevSecOps Pipeline] Scan failed or severe quality issues found. Commit blocked!"
  exit 1
else
  echo "[DevSecOps Pipeline] Scan executed successfully. Proceeding with commit."
  exit 0
fi